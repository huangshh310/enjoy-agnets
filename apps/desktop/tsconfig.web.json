{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.tsx",
    "src/preload/*.d.ts",
    "components/**/*",
    "utils/**/*",
    "src/renderer/src/shims/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@renderer/*": ["src/renderer/src/*"],
      "next/link": ["src/renderer/src/shims/next-link.tsx"]
    }
  }
}
