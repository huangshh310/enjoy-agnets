{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.tsx",
    "src/preload/*.d.ts"
  ],
  "exclude": ["src/renderer/src/**/*.test.ts"],
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "composite": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["../../packages/ui/*"],
      "@renderer/*": ["src/renderer/src/*"],
      "@enjoy-agents/ui": ["../../packages/ui/src/index.ts"],
      "@enjoy-agents/editor": ["../../packages/editor/src/index.ts"],
      "@enjoy-agents/agent-core": ["../../packages/agent-core/src/index.ts"],
      "@enjoy-agents/agent-core/diff": ["../../packages/agent-core/src/diff.ts"],
      "@enjoy-agents/providers/presets": ["../../packages/providers/src/presets.ts"],
      "@enjoy-agents/providers/capabilities": ["../../packages/providers/src/capabilities/catalog.ts"],
      "@enjoy-agents/providers/pricing": ["../../packages/providers/src/pricing/index.ts"],
      "@enjoy-agents/ipc-contract/estimated-cost": ["../../packages/ipc-contract/src/estimated-cost.ts"],
      "@enjoy-agents/ipc-contract/agent-tools": ["../../packages/ipc-contract/src/agent-tools.ts"],
      "@enjoy-agents/assets/media-type": ["../../packages/assets/src/media-type.ts"],
      "@enjoy-agents/assets/playback-url": ["../../packages/assets/src/playback-url.ts"],
      "next/link": ["../../packages/ui/shims/next-link.tsx"]
    }
  }
}
