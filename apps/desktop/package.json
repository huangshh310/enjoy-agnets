{
  "name": "@enjoy-agents/desktop",
  "version": "0.1.8",
  "private": true,
  "description": "Enjoy Agents desktop shell",
  "author": "Enjoy Agents",
  "repository": {
    "type": "git",
    "url": "https://github.com/huangshh310/enjoy-agnets.git"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/ensure-mac-menu-name.mjs && electron-vite dev",
    "start": "node scripts/ensure-mac-menu-name.mjs && electron-vite preview",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\"",

    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "catalog:",
    "@ai-sdk/openai": "catalog:",
    "@blobatar/react": "catalog:",
    "@electron-toolkit/preload": "catalog:",
    "@electron-toolkit/utils": "catalog:",
    "@enjoy-agents/agent-core": "workspace:*",
    "@enjoy-agents/agent-harness": "workspace:*",
    "@enjoy-agents/assets": "workspace:*",
    "@enjoy-agents/db": "workspace:*",
    "@enjoy-agents/editor": "workspace:*",
    "@xterm/addon-fit": "catalog:",
    "@xterm/xterm": "catalog:",
    "node-pty": "catalog:",
    "@enjoy-agents/ipc-contract": "workspace:*",
    "@enjoy-agents/knowledge": "workspace:*",
    "@enjoy-agents/mcp": "workspace:*",
    "@enjoy-agents/providers": "workspace:*",
    "@enjoy-agents/ui": "workspace:*",
    "@fontsource-variable/inter": "catalog:",
    "@fontsource-variable/jetbrains-mono": "catalog:",
    "@internationalized/date": "catalog:",
    "@lobehub/icons": "catalog:",
    "@remixicon/react": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "ai": "catalog:",
    "blobatar": "catalog:",
    "border-beam": "catalog:",
    "mermaid": "catalog:",
    "motion": "catalog:",
    "react": "catalog:",
    "react-aria-components": "catalog:",
